# ---------------------------------------------------------------------------
# GLoW environment variables
# Copy to .env.local and fill in. With no Supabase values the app boots in
# DEMO MODE (in-memory seeded data, no external services required).
# ---------------------------------------------------------------------------

# Public app URL - used for invitation links, ICS files and QR codes.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase -------------------------------------------------------------
# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...), or the legacy anon key. Safe for the
# browser: every request it makes is still governed by Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret key (sb_secret_...), or the legacy service_role key. SERVER ONLY -
# it bypasses Row Level Security. Never prefix this one with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Demo mode ------------------------------------------------------------
# Force demo mode even when Supabase credentials exist ("true" / "false").
NEXT_PUBLIC_DEMO_MODE=

# --- Email notification adapter -------------------------------------------
# When these are missing, notifications are stored in the in-app notification
# center with delivery_status = "skipped_no_provider".
EMAIL_FROM=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# --- Scheduled reminders ---------------------------------------------------
# Shared secret for GET /api/cron/reminders. When set, the endpoint requires
# an "Authorization: Bearer <CRON_SECRET>" header.
CRON_SECRET=

# --- Auth providers --------------------------------------------------------
# Google OAuth is enabled in the UI only when this is "true" AND the provider
# is configured inside the Supabase dashboard.
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false
