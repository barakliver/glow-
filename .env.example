# ---------------------------------------------------------------------------
# GLoW environment variables
# Copy to .env.local and fill in. With no Supabase values the app boots in
# DEMO MODE (in-memory seeded data, no external services required).
#
# None of these are exposed to the browser. The app reaches Supabase only from
# server components, server actions and route handlers, so no NEXT_PUBLIC_
# prefix is needed anywhere.
# ---------------------------------------------------------------------------

# Public URL of the deployment. Used for invitation links, ICS files and QR
# codes. On Vercel this is detected automatically and can be left empty.
APP_URL=http://localhost:3000

# --- Supabase --------------------------------------------------------------
# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=
# Publishable key (sb_publishable_...) or the legacy anon key.
SUPABASE_ANON_KEY=

# That is all Supabase needs. There is deliberately no service-role / secret
# key: every public read goes through a security-definer function that the
# anon role may call, so nothing in the deployment can bypass Row Level
# Security.

# --- Demo mode -------------------------------------------------------------
# Force demo mode even when Supabase credentials exist ("true" / "false").
DEMO_MODE=

# --- Scheduled reminders ---------------------------------------------------
# Shared secret for GET /api/cron/reminders. When set, the endpoint requires
# an "Authorization: Bearer <CRON_SECRET>" header.
CRON_SECRET=

# --- Email notification adapter --------------------------------------------
# When these are missing, notifications are stored in the in-app notification
# center with delivery_status = "skipped_no_provider".
EMAIL_FROM=
RESEND_API_KEY=

# --- Auth providers --------------------------------------------------------
# The club signs in with Google only, so there is nothing to switch on here:
# enable the Google provider inside the Supabase dashboard and add this
# deployment's /auth/callback to its redirect allow list. With no Supabase
# credentials at all the app runs in demo mode, where sign-in is by email
# address and no provider is involved.
